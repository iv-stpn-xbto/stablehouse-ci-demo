{
  "name": "stablehouse-ci-demo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace common build && yarn workspace web build",
    "changeset": "node scripts/add-changeset.mjs patch",
    "changeset:minor": "node scripts/add-changeset.mjs minor",
    "changeset:major": "node scripts/add-changeset.mjs major",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check:changeset": "node scripts/check-changeset-scope.mjs",
    "hotfix": "node scripts/hotfix.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7"
  }
}
